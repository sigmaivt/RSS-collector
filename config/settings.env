# ══════════════════════════════════════
# RSS → LLM → Telegram: Settings
# ══════════════════════════════════════

# LM Studio
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen/qwen3.5-9b
LLM_SEMAPHORE=2

# OpenRouter backup LLM (used for proactive fallback)
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-4.5-air:free
OPENROUTER_TIMEOUT_SEC=120
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=RSS Collector

# RSSHub
RSSHUB_URL=http://localhost:1200
GITHUB_ACCESS_TOKEN=ghp_your_token_here

# Telegram Bot
TG_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TG_ADMIN_CHAT_ID=-100000000000
TG_PROACTIVE_CHAT_ID=-100444444444
TG_PROACTIVE_CREATIVE_CHAT_ID=-100555555555

# Telegram channels (per topic)
TG_CHAT_AI_CODING=-100111111111
TG_CHAT_AI_MODELS=-100222222222
TG_CHAT_ERP_MES=-100333333333

# Pipeline
POLL_INTERVAL_MINUTES=30
CLASSIFIER_TEMPERATURE=0
CLASSIFIER_MAX_TOKENS=5
SUMMARIZER_TEMPERATURE=0.5
SUMMARIZER_MAX_TOKENS=300
MAX_TEXT_LENGTH=15000
JOB_LEASE_MINUTES=10
MAX_SEND_RETRIES=5

# Monitoring
HEALTH_CHECK_INTERVAL_MINUTES=5
ALERT_COOLDOWN_MINUTES=30
DIGEST_HOUR=21

# Proactive reports
PROACTIVE_ENABLED=true
PROACTIVE_DIGEST_HOUR=9
PROACTIVE_MIN_ITEMS_24H=10
PROACTIVE_TRIGGER_THRESHOLD=10
PROACTIVE_TEMPERATURE=0.3
PROACTIVE_MAX_TOKENS=700

# Database
DB_PATH=./data/pipeline.db
