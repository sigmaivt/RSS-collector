# ══════════════════════════════════════
# RSS → LLM → Telegram: Settings
# Copy to .env and fill in real values
# ══════════════════════════════════════

# LM Studio (local LLM server)
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=lfm2-2.6b-exp
LLM_SEMAPHORE=2

# RSSHub (Docker)
RSSHUB_URL=http://localhost:1200
GITHUB_ACCESS_TOKEN=ghp_your_token_here

# Telegram Bot (from @BotFather)
TG_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TG_ADMIN_CHAT_ID=-100000000000

# Telegram channel chat IDs (one per topic)
TG_CHAT_AI_CODING=-100111111111
TG_CHAT_AI_MODELS=-100222222222
TG_CHAT_ERP_MES=-100333333333

# Pipeline tuning
POLL_INTERVAL_MINUTES=30
CLASSIFIER_TEMPERATURE=0
CLASSIFIER_MAX_TOKENS=5
SUMMARIZER_TEMPERATURE=0.5
SUMMARIZER_MAX_TOKENS=300
MAX_TEXT_LENGTH=15000
JOB_LEASE_MINUTES=10
MAX_SEND_RETRIES=5

# Monitoring
HEALTH_CHECK_INTERVAL_MINUTES=5
ALERT_COOLDOWN_MINUTES=30
DIGEST_HOUR=21

# Database
DB_PATH=./data/pipeline.db
